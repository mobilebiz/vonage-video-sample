# このファイルを .env にコピーして値を設定してください:  cp env.example .env

# Vonage Video API (Vonage ダッシュボードで作成したアプリケーション)
VONAGE_APPLICATION_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# QR コードの URL に含める簡易アクセスキー（URL を知らない人の入室・API 利用を防ぐ）
# 例: openssl rand -hex 8
DEMO_ACCESS_KEY=

# 翻訳に使う Bedrock モデル（推論プロファイル ID）
BEDROCK_MODEL_ID=jp.anthropic.claude-haiku-5-5
# 低遅延・最安にしたい場合:
# BEDROCK_MODEL_ID=apac.amazon.nova-micro-v1:0

# 秘密鍵を保存する SSM パラメータ名（npm run put-key で登録）
VONAGE_PRIVATE_KEY_PARAM=/vonage-video-sample/private-key

MAX_PARTICIPANTS=4

# 1 回の会議の最大時間（秒）。誰かが入室してから全員が退出するまで。過ぎると全員を強制退出
MEETING_MAX_SECONDS=180

# 月額予算アラート（Project タグ + Transcribe の合計）。メールアドレスが空なら予算は作らない
BUDGET_ALERT_EMAIL=
BUDGET_AMOUNT_USD=100
PROJECT_TAG=vonage-video-sample

# ---- ローカル開発 (npm run dev) 用 ----
# VONAGE_PRIVATE_KEY_PATH=./private.key
# AWS_PROFILE=kwc-v4g
# AWS_REGION=ap-northeast-1
