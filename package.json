{
  "name": "vonage-video-sample",
  "version": "1.0.0",
  "private": true,
  "description": "Vonage Video API + Amazon Transcribe + Amazon Bedrock による多言語字幕つきビデオ会議デモ (AWS サーバーレス)",
  "type": "module",
  "scripts": {
    "dev": "node local/dev-server.js",
    "put-key": "node scripts/put-private-key.js",
    "synth": "cdk synth",
    "deploy": "cdk deploy --require-approval never",
    "destroy": "cdk destroy",
    "qr": "node scripts/qr.js",
    "test": "node --test test/*.test.js",
    "activate-tag": "node scripts/activate-cost-tag.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1161.0",
    "@aws-sdk/client-cloudformation": "^3.1161.0",
    "@aws-sdk/client-scheduler": "^3.1162.0",
    "@aws-sdk/client-ssm": "^3.1161.0",
    "@aws-sdk/credential-provider-node": "^3.972.92",
    "@smithy/signature-v4": "^5.7.5",
    "@vonage/auth": "^1.18.1",
    "@vonage/jwt": "^1.17.1",
    "@vonage/video": "^1.31.1"
  },
  "devDependencies": {
    "@aws-sdk/client-cost-explorer": "^3.1162.0",
    "aws-cdk": "^2.1147.0",
    "aws-cdk-lib": "^2.275.0",
    "constructs": "^10.8.1",
    "dotenv": "^18.0.9",
    "esbuild": "^0.28.2",
    "qrcode": "^1.5.4",
    "ws": "^8.22.1"
  }
}
